    {
      "id": "med-5",
      "title": " MORSE CODE | FROM THE OTHER SIDE",
      "publication": "Detectives Of Supernatural",
      "date": "2024-08-16",
      "category": "Youtube",
      "description": "Overall the outer structures of the building are in better condition than the interior ones. According to the locals, the post office was still functional around ten years back and with the crumbling state of the building and no maintenance the post office was forced to move out. There is a huge staircase made of bricks which takes you to the second floor and there you will still be able to see the two locked rooms on the north side full of old chairs, tables, and other furniture which once belonged to the post office. The rooms on the southern sides have no remaining floors and can be seen from the ground floor.",
      "externalUrl": "https://www.youtube.com/watch?v=zNfNJTIUXa4",
      "thumbnail": "/uploads/file-1790005303949-916584292.jpg",
      "isPublished": true,
      "createdAt": "2024-08-17T18:00:00Z",
      "videoUrl": "https://www.youtube.com/watch?v=zNfNJTIUXa4"
    },
    {
